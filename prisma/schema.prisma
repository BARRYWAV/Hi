generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id // "alejandro" or "lesly"
  name        String
  displayName String
  avatarUrl   String?
  createdAt   DateTime @default(now())

  habitLogs           HabitLog[]
  financeTransactions FinanceTransaction[]
  debts               Debt[]
  calendarEvents      CalendarEvent[]
  workoutProfile      WorkoutProfile?
  workoutSessions     WorkoutSession[]
  biometrics          BiometricLog[]
}

model HabitLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String   // YYYY-MM-DD
  poopCount  Int      @default(0)
  waterMl    Int      @default(0)
  loveCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date])
}

model FinanceTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // "INCOME" or "EXPENSE"
  amount      Float
  account     String   // "Nu", "BBVA", "Efectivo"
  concept     String?
  category    String?  // "Comida", "Transporte", "Servicios", "Entretenimiento", etc.
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Debt {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactName String
  totalAmount Float
  paidAmount  Float         @default(0)
  type        String        // "I_OWE" or "THEY_OWE"
  status      String        @default("ACTIVE") // "ACTIVE" or "SETTLED"
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  payments    DebtPayment[]
}

model DebtPayment {
  id        String   @id @default(cuid())
  debtId    String
  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount    Float
  date      DateTime @default(now())
  notes     String?
}

model SharedSavingsGoal {
  id            String    @id @default(cuid())
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  targetDate    DateTime?
  updatedAt     DateTime  @updatedAt
}

model CalendarEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  date      String   // YYYY-MM-DD
  startTime String?  // "HH:mm"
  endTime   String?  // "HH:mm"
  isAllDay  Boolean  @default(false)
  category  String   // "Trabajo", "Personal", "Salud", "Social", "Hogar"
  color     String   // Hex or token color
  isPrivate Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Meal {
  id          String           @id @default(cuid())
  name        String
  type        String           // "BREAKFAST", "LUNCH", "DINNER"
  calories    Int
  prepTimeMin Int              @default(20)
  imageUrl    String?
  description String?
  ingredients MealIngredient[]
  plans       WeeklyMealPlan[]
  createdAt   DateTime         @default(now())
}

model MealIngredient {
  id       String @id @default(cuid())
  mealId   String
  meal     Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name     String
  quantity Float
  unit     String // "g", "ml", "piezas", "cdas", "tazas"
  category String // "Lácteos", "Proteínas", "Frutas y Verduras", "Despensa", "Panadería"
}

model WeeklyMealPlan {
  id        String   @id @default(cuid())
  dayOfWeek String   // "monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"
  mealType  String   // "BREAKFAST", "LUNCH", "DINNER"
  mealId    String
  meal      Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  portions  Int      @default(2)
  createdAt DateTime @default(now())
}

model SupermarketItem {
  id        String   @id @default(cuid())
  name      String
  quantity  Float
  unit      String
  category  String   // "Lácteos", "Proteínas", "Frutas y Verduras", "Despensa", "Otros"
  checked   Boolean  @default(false)
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model WorkoutProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg              Float
  heightCm              Float
  equipment             String   // JSON string array e.g. '["mancuernas","piso","cajon"]'
  daysPerWeek           Int      @default(3)
  durationPerSessionMin Int      @default(45)
  updatedAt             DateTime @updatedAt
}

model WorkoutSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  routineName String
  durationMin Int
  completed   Boolean  @default(true)
  exercises   String   // JSON string of exercises list
  createdAt   DateTime @default(now())
}

model BiometricLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  weightKg  Float
  heightCm  Float?
}
